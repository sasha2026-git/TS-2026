---
import '../styles/global.css';
const { title } = Astro.props;
const path = Astro.url ? Astro.url.pathname : '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} · TennisMatch</title>
  <meta name="description" content="Court Élégance — tennis events, AI NTRP rating, travel and equipment journal." />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500&family=Noto+Serif+SC:wght@500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="mag-header">
    <div class="topbar">
      <span data-en="Issue Nº 01 — Automne 2026" data-zh="第 01 期 — 2026 秋季刊">Issue Nº 01 — Automne 2026</span>
      <span data-en="Court Élégance" data-zh="球场风雅" style="letter-spacing:0.2em;">Court Élégance</span>
      <button id="langToggle" class="lang-btn" data-i18n="nav.lang">中文</button>
    </div>

    <div class="brandrow">
      <button class="hamburger" id="menuToggle" aria-label="Menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <a class="wordmark" href="/">Tennis<em>Match</em></a>
      <span class="brandrule" data-en="Roland-Garros · Paris" data-zh="罗兰加洛斯 · 巴黎">Roland-Garros · Paris</span>
    </div>

    <nav class="navbar">
      <ul class="nav-links" id="navLinks">
        <li><a href="/" data-i18n="nav.home" aria-current={isActive('/') ? 'page' : undefined}>Home</a></li>
        <li><a href="/events" data-i18n="nav.events" aria-current={isActive('/events') ? 'page' : undefined}>Events</a></li>
        <li><a href="/ai-coach" data-i18n="nav.ai" aria-current={isActive('/ai-coach') ? 'page' : undefined}>AI Coach</a></li>
        <li><a href="/vacation" data-i18n="nav.vacation" aria-current={isActive('/vacation') ? 'page' : undefined}>Vacation</a></li>
        <li><a href="/gear" data-i18n="nav.gear" aria-current={isActive('/gear') ? 'page' : undefined}>Gear</a></li>
      </ul>
    </nav>
  </header>

  <main><slot /></main>

  <footer class="mag-footer">
    <div class="footer-top">
      <div class="footer-wordmark">Tennis<em>Match</em></div>
      <div class="footer-rule"></div>
      <div class="footer-grid">
        <div class="footer-col">
          <h4 data-i18n="footer.col.product">Product</h4>
          <ul>
            <li><a href="/events" data-i18n="nav.events">Events</a></li>
            <li><a href="/ai-coach" data-i18n="nav.ai">AI Coach</a></li>
            <li><a href="/vacation" data-i18n="nav.vacation">Vacation</a></li>
            <li><a href="/gear" data-i18n="nav.gear">Gear</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4 data-i18n="footer.col.company">Company</h4>
          <ul>
            <li><a href="/" data-i18n="nav.home">Home</a></li>
            <li><a href="/#pricing" data-i18n="pricing.title">Membership Plans</a></li>
            <li><a href="/#contents" data-en="Masthead" data-zh="刊头">Masthead</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4 data-i18n="footer.col.resources">Resources</h4>
          <ul>
            <li><a href="/vacation" data-en="Voyages" data-zh="旅行专栏">Voyages</a></li>
            <li><a href="/gear" data-en="Équipement" data-zh="装备专栏">Équipement</a></li>
            <li><a href="/ai-coach" data-en="NTRP Rating" data-zh="NTRP 评级">NTRP Rating</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4 data-i18n="footer.col.legal">Legal</h4>
          <ul>
            <li><a href="#privacy" data-en="Privacy" data-zh="隐私政策">Privacy</a></li>
            <li><a href="#terms" data-en="Terms" data-zh="服务条款">Terms</a></li>
            <li><a href="#affiliate" data-en="Affiliate Disclosure" data-zh="联盟推广声明">Affiliate Disclosure</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p data-i18n="footer.rights">© 2026 TennisMatch · 法网风格红土美学</p>
      <p data-i18n="footer.note">Demo build — ratings and payments are placeholders.</p>
    </div>
  </footer>

  <div class="toast" id="toast"></div>

  <script>
    import dict from '../data/i18n.json';

    let lang = 'en';
    try { lang = localStorage.getItem('lang') || 'en'; } catch { lang = 'en'; }
    if (lang !== 'zh') lang = 'en';

    function apply() {
      document.documentElement.lang = lang;
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (dict[lang] && dict[lang][key]) el.textContent = dict[lang][key];
      });
      document.querySelectorAll('[data-en]').forEach(el => {
        el.textContent = el.getAttribute(lang === 'en' ? 'data-en' : 'data-zh');
      });
      const langBtn = document.getElementById('langToggle');
      if (langBtn) langBtn.textContent = lang === 'en' ? '中文' : 'English';
    }

    document.getElementById('langToggle')?.addEventListener('click', () => {
      lang = lang === 'en' ? 'zh' : 'en';
      try { localStorage.setItem('lang', lang); } catch {}
      apply();
    });

    const menuToggle = document.getElementById('menuToggle');
    const navLinks = document.getElementById('navLinks');
    menuToggle?.addEventListener('click', () => {
      const open = menuToggle.classList.toggle('open');
      navLinks?.classList.toggle('open');
      menuToggle.setAttribute('aria-expanded', String(open));
    });
    navLinks?.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        menuToggle?.classList.remove('open');
        navLinks?.classList.remove('open');
      });
    });

    apply();

    window.showToast = function (msg, duration = 3000) {
      const t = document.getElementById('toast');
      if (!t) return;
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), duration);
    };
  </script>
</body>
</html>
