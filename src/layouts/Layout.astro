---
import '../styles/global.css';
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} · Tennis Open</title>
  <meta name="description" content="Tennis events, AI rating & coach, vacation and gear guides." />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="nav">
    <a class="brand" href="/">🎾 Tennis <em>Open</em></a>
    <nav>
      <a href="/" data-i18n="nav.home">Home</a>
      <a href="/#events" data-i18n="nav.events">Events</a>
      <a href="/ai-coach" data-i18n="nav.ai">AI Rating & Coach</a>
      <a href="/vacation" data-i18n="nav.vacation">Tennis Vacation</a>
      <a href="/gear" data-i18n="nav.gear">Gear Guide</a>
      <button id="langToggle" class="lang-btn" data-i18n="nav.lang">中文</button>
    </nav>
  </header>
  <main><slot /></main>
  <footer class="footer">
    <p>© 2026 Tennis Open — <span data-i18n="footer.note">Demo build — ratings and payments are placeholders.</span></p>
  </footer>
  <script>
    const dict = await fetch('/data/i18n.json').then(r => r.json());
    let lang = localStorage.getItem('lang') || 'en';
    function apply() {
      document.documentElement.lang = lang;
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (dict[lang] && dict[lang][key]) el.textContent = dict[lang][key];
      });
      document.querySelectorAll('[data-en]').forEach(el => {
        el.textContent = el.getAttribute(lang === 'en' ? 'data-en' : 'data-zh');
      });
    }
    document.getElementById('langToggle')?.addEventListener('click', () => {
      lang = lang === 'en' ? 'zh' : 'en';
      localStorage.setItem('lang', lang);
      apply();
    });
    apply();
  </script>
</body>
</html>
