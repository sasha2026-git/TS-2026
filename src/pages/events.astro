---
import Layout from '../layouts/Layout.astro';
import events from '../data/events.json';
const list = events.events;
---
<Layout title="Events">
  <section class="page-opener">
    <span class="kicker" data-en="Le Calendrier — Nº 01" data-zh="赛程 — 第 01 期">Le Calendrier — Nº 01</span>
    <h1 data-i18n="events.title">Upcoming Events</h1>
    <p class="standfirst" data-i18n="events.sub">Register for level-matched tournaments and social play. Payment via Stripe — coming soon.</p>
    <div class="rule-double"></div>
  </section>

  <section class="section section--tight">
    <div class="table-scroll">
      <table class="htable">
        <thead>
          <tr>
            <th data-en="Date" data-zh="日期">Date</th>
            <th data-i18n="events.city">City</th>
            <th data-en="Rencontre" data-zh="赛事">Rencontre</th>
            <th data-i18n="events.level">Level</th>
            <th data-i18n="events.fee">Fee</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {list.map(ev => (
            <tr>
              <td>
                {ev.date}
                <span class="t-sub">{ev.time}</span>
              </td>
              <td><span data-en={ev.city.en} data-zh={ev.city.zh}>{ev.city.en}</span></td>
              <td>
                <span class="t-title" data-en={ev.title.en} data-zh={ev.title.zh}>{ev.title.en}</span>
                <span class="t-sub" data-en={ev.venue.en} data-zh={ev.venue.zh}>{ev.venue.en}</span>
              </td>
              <td><span class="ntrp-badge" data-en={ev.level.en} data-zh={ev.level.zh}>{ev.level.en}</span></td>
              <td class="t-price">¥{ev.fee}</td>
              <td>
                <button
                  class="btn btn--sm signup-btn"
                  data-event-id={ev.id}
                  data-event-title-en={ev.title.en}
                  data-event-title-zh={ev.title.zh}
                  data-i18n="events.signup">Register</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="font-size:0.75rem;color:var(--ink-faint);letter-spacing:0.12em;text-transform:uppercase;margin-top:1.5rem;"
       data-en="Entries are held locally · Payment channel coming soon"
       data-zh="报名信息暂存本机 · 支付通道即将开放">Entries are held locally · Payment channel coming soon</p>
  </section>

  <section class="section section--tight">
    <div class="form-card" id="signupForm" style="display:none;">
      <span class="kicker" data-en="Bulletin d'engagement" data-zh="报名表">Bulletin d'engagement</span>
      <h3 data-i18n="events.form.title">Registration Form</h3>
      <p class="form-lead" data-en="Fields marked with a rule line are required." data-zh="填写以下信息完成报名。">Fields marked with a rule line are required.</p>
      <form id="regForm">
        <div class="form-grid">
          <div class="form-group">
            <label for="regName" data-i18n="events.form.name">Full Name</label>
            <input type="text" id="regName" required />
          </div>
          <div class="form-group">
            <label for="regEmail" data-i18n="events.form.email">Email</label>
            <input type="email" id="regEmail" required />
          </div>
          <div class="form-group">
            <label for="regLevel" data-i18n="events.form.level">Your NTRP Level</label>
            <select id="regLevel">
              <option value="1.0-2.5">NTRP 1.0-2.5</option>
              <option value="2.5-3.0">NTRP 2.5-3.0</option>
              <option value="3.0-3.5">NTRP 3.0-3.5</option>
              <option value="3.5-4.0">NTRP 3.5-4.0</option>
              <option value="4.0-4.5">NTRP 4.0-4.5</option>
              <option value="4.5-5.0">NTRP 4.5-5.0</option>
            </select>
          </div>
          <div class="form-group">
            <label for="regEvent" data-i18n="events.form.event">Selected Event</label>
            <input type="text" id="regEvent" readonly />
          </div>
          <div class="form-actions">
            <button type="submit" class="btn" data-i18n="events.form.submit">Continue to Payment</button>
            <button type="button" class="btn btn--outline" id="cancelForm" data-i18n="events.form.cancel">Cancel</button>
          </div>
        </div>
      </form>
    </div>

    <div class="pay-stub" id="payPlaceholder" style="display:none;">
      <div>
        <p data-i18n="events.pay.placeholder">Payment channel coming soon</p>
        <span class="stub-note" data-en="Stripe checkout is not enabled in this build." data-zh="本版本尚未启用 Stripe 支付。">Stripe checkout is not enabled in this build.</span>
      </div>
      <button class="btn" id="payBtn">Stripe · Pay (Nº 01)</button>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('signupForm')!;
  const payPlaceholder = document.getElementById('payPlaceholder')!;
  const regEventInput = document.getElementById('regEvent') as HTMLInputElement;

  document.querySelectorAll('.signup-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const eventId = btn.getAttribute('data-event-id');
      const lang = localStorage.getItem('lang') || 'en';
      const titleAttr = lang === 'en' ? 'data-event-title-en' : 'data-event-title-zh';
      const title = btn.getAttribute(titleAttr) || btn.getAttribute('data-event-title-en') || '';

      const registration = {
        eventId,
        name: '',
        email: '',
        level: '',
        eventTitle: title,
        timestamp: new Date().toISOString()
      };

      const existing = JSON.parse(localStorage.getItem('tennis_registrations') || '[]');
      existing.push(registration);
      localStorage.setItem('tennis_registrations', JSON.stringify(existing));

      regEventInput.value = title;
      form.style.display = 'block';
      form.scrollIntoView({ behavior: 'smooth' });
    });
  });

  document.getElementById('cancelForm')?.addEventListener('click', () => {
    form.style.display = 'none';
    payPlaceholder.style.display = 'none';
  });

  document.getElementById('regForm')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('regName') as HTMLInputElement).value;
    const email = (document.getElementById('regEmail') as HTMLInputElement).value;
    const level = (document.getElementById('regLevel') as HTMLSelectElement).value;

    const existing = JSON.parse(localStorage.getItem('tennis_registrations') || '[]');
    if (existing.length > 0) {
      existing[existing.length - 1].name = name;
      existing[existing.length - 1].email = email;
      existing[existing.length - 1].level = level;
      localStorage.setItem('tennis_registrations', JSON.stringify(existing));
    }

    form.style.display = 'none';
    payPlaceholder.style.display = 'flex';
    payPlaceholder.scrollIntoView({ behavior: 'smooth' });
  });

  document.getElementById('payBtn')?.addEventListener('click', () => {
    alert('Stripe checkout placeholder — payment channel coming soon.');
  });
</script>
