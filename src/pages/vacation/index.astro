---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/blog-vacation.json';
const posts = data.posts;
---
<Layout title="Tennis Vacation">
  <section class="hero" style="padding:4rem 5vw;">
    <h1 data-i18n="blog.title.vacation">Tennis Vacation</h1>
    <p>Hotels, academies and destinations for tennis travelers.</p>
  </section>
  <section class="blog-grid">
    <div class="cards">
      {posts.map(p => (
        <div class="card">
          <img src={p.image} alt={p.title.en} />
          <div class="body">
            <span class="badge">{p.date}</span>
            <h3 data-en={p.title.en} data-zh={p.title.zh}>{p.title.en}</h3>
            <p class="excerpt" data-en={p.excerpt.en} data-zh={p.excerpt.zh}>{p.excerpt.en}</p>
            <a class="btn btn-clay" href={`/vacation/${p.slug}`} data-i18n="blog.read">Read more</a>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
