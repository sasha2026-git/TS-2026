---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/blog-vacation.json';
const posts = data.posts;
const feature = posts[0];
const rest = posts.slice(1);
---
<Layout title="Tennis Vacation">
  <header class="journal-head">
    <div class="rule-double"></div>
    <div class="journal-meta">
      <span data-en="Voyages" data-zh="旅行专栏">Voyages</span>
      <span data-en="Issue No.01" data-zh="第 01 期">Issue No.01</span>
      <span data-en="Roland-Garros · Paris" data-zh="罗兰加洛斯 · 巴黎">Roland-Garros · Paris</span>
    </div>
    <h1 class="journal-title"><span data-i18n="blog.title.vacation">Tennis Vacation</span></h1>
    <p class="journal-stand" data-i18n="blog.sub.vacation">Destination guides, hotel picks, and court reviews for tennis travelers.</p>
  </header>

  <section class="contents">
    <article class="feature">
      <a class="thumb" href={`/vacation/${feature.slug}`}>
        <img src={feature.image} alt={feature.title.en} />
      </a>
      <div>
        <span class="kicker kicker--clay" data-en="Grand Portfolio — Cover Story" data-zh="封面故事 — 大图">Grand Portfolio — Cover Story</span>
        <h2 class="f-title"><a href={`/vacation/${feature.slug}`} data-en={feature.title.en} data-zh={feature.title.zh}>{feature.title.en}</a></h2>
        <p class="f-excerpt" data-en={feature.excerpt.en} data-zh={feature.excerpt.zh}>{feature.excerpt.en}</p>
        <p style="font-size:0.6875rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--ink-faint);margin:1.25rem 0 1.5rem;">
          <span data-i18n="blog.hotels">Recommended Hotels</span> · {feature.date}
        </p>
        <a class="link-more" href={`/vacation/${feature.slug}`} data-en="Lire plus →" data-zh="阅读全文 →">Lire plus →</a>
      </div>
    </article>

    <div class="post-grid">
      {rest.map((p, i) => (
        <article class="post-card">
          <a class="thumb" href={`/vacation/${p.slug}`}>
            <img src={p.image} alt={p.title.en} />
          </a>
          <span class="p-num">{`0${i + 2}`}</span>
          <span class="kicker" style="margin:0.5rem 0 0.25rem;">{p.date} — <span data-en="Voyages" data-zh="旅行">Voyages</span></span>
          <h3><a href={`/vacation/${p.slug}`} data-en={p.title.en} data-zh={p.title.zh}>{p.title.en}</a></h3>
          <p class="p-excerpt" data-en={p.excerpt.en} data-zh={p.excerpt.zh}>{p.excerpt.en}</p>
          <a class="link-more" href={`/vacation/${p.slug}`} data-en="Lire plus →" data-zh="阅读全文 →">Lire plus →</a>
        </article>
      ))}
    </div>

    <p class="affiliate-note" data-en="Hotel and booking links in these guides are affiliate links." data-zh="专栏中的酒店与预订链接为联盟推广链接。">Hotel and booking links in these guides are affiliate links.</p>
  </section>
</Layout>
