---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/blog-vacation.json';
export function getStaticPaths() {
  return data.posts.map(p => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props;
---
<Layout title={post.title.en}>
  <article class="article">
    <a href="/vacation" class="back-link" data-i18n="blog.back">← All posts</a>
    <h1 data-en={post.title.en} data-zh={post.title.zh}>{post.title.en}</h1>
    <p class="article-meta">📅 {post.date}</p>
    <img src={post.image} alt={post.title.en} class="cover-img" />
    <div class="prose" data-en={post.body.en} data-zh={post.body.zh}>{post.body.en}</div>

    {post.hotels && post.hotels.length > 0 && (
      <div class="recommendations">
        <h3 data-i18n="blog.hotels">Recommended Hotels</h3>
        {post.hotels.map((h: any) => (
          <div class="rec-card">
            <div class="rec-info">
              <h4>{h.name} {'⭐'.repeat(h.stars)}</h4>
              <p data-en={h.note.en} data-zh={h.note.zh}>{h.note.en}</p>
            </div>
            <div style="display:flex;align-items:center;gap:0.8rem;">
              <span class="rec-price">{h.priceFrom}</span>
              <a class="btn btn-clay btn-sm" href={h.link} data-i18n="blog.affiliate">Book</a>
            </div>
          </div>
        ))}
      </div>
    )}

    <p class="affiliate-note" data-en={post.affiliateNote.en} data-zh={post.affiliateNote.zh}>{post.affiliateNote.en}</p>
  </article>
</Layout>
