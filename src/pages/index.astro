<svg width="0" height="0" style="position:absolute"><defs>
<g id="tp-ball"><circle cx="24" cy="24" r="23" fill="#D97A45"/><path d="M6 10c8 6 8 22 0 28M42 10c-8 6-8 22 0 28" stroke="#F5F1EA" stroke-width="2.6" fill="none" stroke-linecap="round"/></g>
</defs></svg>

<!-- ================= NAV ================= -->
<header>
  <div class="wrap nav">
