      <a href="#story" data-zh="我们的故事" data-en="Our Story">我们的故事</a>
      <a href="#games" data-zh="近期球局" data-en="Games">近期球局</a>
      <a href="#coach" data-zh="AI 教练" data-en="AI Coach">AI 教练</a>
      <a href="#blog" data-zh="博客" data-en="Blog">博客</a>
    </nav>
    <div class="nav-tools">
