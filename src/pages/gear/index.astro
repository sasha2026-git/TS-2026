---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/blog-gear.json';
const posts = data.posts;
const feature = posts[0];
const rest = posts.slice(1);
---
<Layout title="Gear Guide">
  <header class="journal-head">
    <div class="rule-double"></div>
    <div class="journal-meta">
      <span data-en="Équipement" data-zh="装备专栏">Équipement</span>
      <span data-en="Issue No.01" data-zh="第 01 期">Issue No.01</span>
      <span data-en="Tested on clay" data-zh="红土实测">Tested on clay</span>
    </div>
    <h1 class="journal-title"><span data-i18n="blog.title.gear">Gear Guide</span></h1>
    <p class="journal-stand" data-i18n="blog.sub.gear">Equipment reviews — rackets, shoes, strings, and bags — tested by real players.</p>
  </header>

  <section class="contents">
    <article class="feature">
      <a class="thumb" href={`/gear/${feature.slug}`}>
        <img src={feature.image} alt={feature.title.en} />
      </a>
      <div>
        <span class="kicker kicker--clay" data-en="Test de Matériel — Cover Story" data-zh="装备实测 — 封面故事">Test de Matériel — Cover Story</span>
        <h2 class="f-title"><a href={`/gear/${feature.slug}`} data-en={feature.title.en} data-zh={feature.title.zh}>{feature.title.en}</a></h2>
        <p class="f-excerpt" data-en={feature.excerpt.en} data-zh={feature.excerpt.zh}>{feature.excerpt.en}</p>
        <p style="font-size:0.6875rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--ink-faint);margin:1.25rem 0 1.5rem;">
          <span data-i18n="blog.products">Recommended Gear</span> · {feature.date}
        </p>
        <a class="link-more" href={`/gear/${feature.slug}`} data-en="Lire plus →" data-zh="阅读全文 →">Lire plus →</a>
      </div>
    </article>

    <div class="post-grid">
      {rest.map((p, i) => (
        <article class="post-card">
          <a class="thumb" href={`/gear/${p.slug}`}>
            <img src={p.image} alt={p.title.en} />
          </a>
          <span class="p-num">{`0${i + 2}`}</span>
          <span class="kicker" style="margin:0.5rem 0 0.25rem;">{p.date} — <span data-en="Équipement" data-zh="装备">Équipement</span></span>
          <h3><a href={`/gear/${p.slug}`} data-en={p.title.en} data-zh={p.title.zh}>{p.title.en}</a></h3>
          <p class="p-excerpt" data-en={p.excerpt.en} data-zh={p.excerpt.zh}>{p.excerpt.en}</p>
          <a class="link-more" href={`/gear/${p.slug}`} data-en="Lire plus →" data-zh="阅读全文 →">Lire plus →</a>
        </article>
      ))}
    </div>

    <p class="affiliate-note" data-en="Purchase links in these reviews are affiliate links." data-zh="测评中的购买链接为联盟推广链接。">Purchase links in these reviews are affiliate links.</p>
  </section>
</Layout>
