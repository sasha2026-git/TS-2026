---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/blog-gear.json';
const posts = data.posts;
---
<Layout title="Gear Guide">
  <section class="hero" style="padding:4rem 5vw 4.5rem;">
    <h1 data-i18n="blog.title.gear">Gear Guide</h1>
    <p data-i18n="blog.sub.gear">Equipment reviews — rackets, shoes, strings, and bags — tested by real players.</p>
  </section>
  <section class="section">
    <div class="cards">
      {posts.map(p => (
        <div class="card">
          <img src={p.image} alt={p.title.en} />
          <div class="body">
            <span class="badge">{p.date}</span>
            <h3 data-en={p.title.en} data-zh={p.title.zh}>{p.title.en}</h3>
            <p class="meta" data-en={p.excerpt.en} data-zh={p.excerpt.zh}>{p.excerpt.en}</p>
            <a class="btn btn-clay btn-sm" href={`/gear/${p.slug}`} data-i18n="blog.read">Read more</a>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
