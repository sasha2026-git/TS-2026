---
import Layout from '../layouts/Layout.astro';
import evaluations from '../data/evaluations.json';
const ranked = [...evaluations.evaluations].sort((a, b) => b.score - a.score);
const strokes = [
  { key: 'forehand', i18n: 'ai.stroke.forehand', en: 'Forehand', zh: '正手' },
  { key: 'backhand', i18n: 'ai.stroke.backhand', en: 'Backhand', zh: '反手' },
  { key: 'serve', i18n: 'ai.stroke.serve', en: 'Serve', zh: '发球' },
  { key: 'volley', i18n: 'ai.stroke.volley', en: 'Volley', zh: '截击' },
];
---
<Layout title="AI Coach">
  <section class="page-opener">
    <span class="kicker" data-en="La Notation — AI Coaching" data-zh="评级 — AI 教练">La Notation — AI Coaching</span>
    <h1 data-i18n="ai.title">AI Tennis Rating &amp; Coach</h1>
    <p class="standfirst" data-i18n="ai.sub">Upload 10 seconds of each stroke — forehand, backhand, serve, and volley. Our AI rates your NTRP level (1.0–7.0) and gives personalized coach feedback.</p>
    <div class="rule-double"></div>
  </section>

  <section class="section section--tight">
    <div class="quota-strip">
      <div class="quota-cell">
        <span class="q-label" data-i18n="pricing.free">Free</span>
        <p class="q-value" data-i18n="ai.quota.free">Free member: 3 evaluations / month</p>
      </div>
      <div class="quota-cell">
        <span class="q-label" data-i18n="pricing.pro">Pro</span>
        <p class="q-value" data-i18n="ai.quota.pro">Pro member: 30 evaluations / month + priority queue</p>
      </div>
    </div>

    <div class="section-head">
      <h2 data-i18n="ai.upload">Upload 10s Video</h2>
      <p class="section-sub" data-en="Four plates, four strokes. Click a plate to choose a file." data-zh="四个版面，四个动作。点击版面选择文件。">Four plates, four strokes. Click a plate to choose a file.</p>
    </div>

    <div class="upload-grid">
      {strokes.map((s, i) => (
        <div class="upload-zone" data-stroke={s.key}>
          <span class="u-index">{`Planche 0${i + 1}`}</span>
          <div class="label" data-i18n={s.i18n} data-en={s.en} data-zh={s.zh}>{s.en}</div>
          <div class="hint" data-i18n="ai.upload.hint">MP4 / MOV, ≤ 30 MB</div>
          <div class="frame" data-en="Choose file" data-zh="选择文件">Choose file</div>
          <div class="file-name"></div>
          <div class="error"></div>
        </div>
      ))}
    </div>

    <div style="margin-top:clamp(1.75rem,4vw,2.5rem);">
      <button class="btn" id="rateBtn" data-i18n="ai.submit">Get My Rating</button>
    </div>

    <div class="result-sheet" id="result">
      <span class="kicker" data-en="Votre Résultat" data-zh="你的测评结果">Votre Résultat</span>
      <div class="result-grid">
        <div class="result-item">
          <p class="r-label" data-i18n="ai.result.score">Overall Score</p>
          <p class="r-value"><span id="rScore">—</span><span style="font-size:0.35em;color:var(--ink-faint);"> / 100</span></p>
        </div>
        <div class="result-item">
          <p class="r-label" data-i18n="ai.result.level">NTRP Level</p>
          <p class="r-value"><span class="ntrp-badge ntrp-badge--solid" id="rNtrp" style="font-size:0.45em;">—</span></p>
        </div>
        <div class="result-item">
          <p class="r-label" data-i18n="ai.result.cta">Browse matching events →</p>
          <p class="r-value" style="font-size:1.15rem;"><a class="link-more" href="/events" data-en="See the draw" data-zh="查看对应签表">See the draw</a></p>
        </div>
      </div>
      <p class="result-note"><span data-i18n="ai.result.coach">Coach Feedback</span> — <span id="rCoach">—</span></p>
      <p style="font-size:0.8125rem;color:var(--ink-faint);margin-top:1rem;"><span data-i18n="ai.result.eligible">You're eligible for level-matched events!</span></p>
    </div>
  </section>

  <section class="plate-green">
    <div class="inner">
      <div class="section-head" style="border-bottom-color:rgba(255,255,255,0.4);">
        <h2 data-i18n="ai.leaderboard">Community Leaderboard</h2>
        <p class="section-sub" style="color:rgba(255,255,255,0.7);text-align:right;" data-i18n="ai.leaderboard.note">Demo leaderboard — local data only</p>
      </div>
      <div class="table-scroll">
        <table class="htable leaderboard">
          <thead>
            <tr>
              <th data-i18n="ai.leaderboard.rank">#</th>
              <th data-i18n="ai.leaderboard.player">Player</th>
              <th data-i18n="ai.leaderboard.score">Score</th>
              <th data-i18n="ai.leaderboard.ntrp">NTRP</th>
              <th data-i18n="ai.leaderboard.date">Date</th>
              <th data-i18n="ai.leaderboard.highlight">Highlight</th>
            </tr>
          </thead>
          <tbody>
            {ranked.map((e, i) => (
              <tr class={i < 3 ? 'rank-top' : ''}>
                <td>{`0${i + 1}`.slice(-2)}</td>
                <td><span class="t-title">{e.player}</span></td>
                <td>{e.score}</td>
                <td><span class="ntrp-badge">{e.ntrp}</span></td>
                <td>{e.date}</td>
                <td style="max-width:32ch;" data-en={e.highlight.en} data-zh={e.highlight.zh}>{e.highlight.en}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="pricing">
    <div class="section-head">
      <h2 data-i18n="pricing.title">Membership Plans</h2>
      <p class="section-sub" data-i18n="pricing.sub">Choose the plan that fits your game.</p>
    </div>
    <div class="table-scroll">
      <table class="plan-table">
        <thead>
          <tr>
            <th style="width:46%;"><span class="feat" data-en="Formule" data-zh="方案对比">Formule</span></th>
            <th>
              <span data-i18n="pricing.free">Free</span>
              <span class="price-line"><span data-i18n="pricing.price.free">¥0</span> · <span data-i18n="pricing.period.free">forever</span></span>
            </th>
            <th>
              <span data-i18n="pricing.pro">Pro</span>
              <span class="price-line"><span data-i18n="pricing.price.pro">¥68</span><span data-i18n="pricing.period.pro">/ month</span></span>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td data-en="AI evaluations" data-zh="AI 测评额度">AI evaluations</td>
            <td class="yes" data-en="3 / month" data-zh="每月 3 次">3 / month</td>
            <td class="yes" data-en="30 / month" data-zh="每月 30 次">30 / month</td>
          </tr>
          <tr>
            <td data-en="Priority evaluation queue" data-zh="优先评测排队">Priority evaluation queue</td>
            <td class="no">—</td>
            <td class="yes">✓</td>
          </tr>
          <tr>
            <td data-en="Personalized training plan" data-zh="专属训练计划">Personalized training plan</td>
            <td class="no">—</td>
            <td class="yes">✓</td>
          </tr>
          <tr>
            <td></td>
            <td><a class="btn btn--outline btn--sm" href="#" data-i18n="pricing.free.cta">Sign Up Free</a></td>
            <td><button class="btn btn--sm subscribe-btn" data-i18n="pricing.pro.cta">Subscribe with Stripe</button></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</Layout>

<script>
  const strokes = ['forehand', 'backhand', 'serve', 'volley'];
  const uploadedFiles: Record<string, File | null> = {};

  document.querySelectorAll('.upload-zone').forEach(zone => {
    zone.addEventListener('click', () => {
      const input = document.createElement('input');
      input.type = 'file';
      input.accept = 'video/mp4,video/quicktime';
      input.onchange = () => {
        const file = input.files?.[0];
        if (!file) return;

        const stroke = zone.getAttribute('data-stroke')!;
        const fileNameEl = zone.querySelector('.file-name')!;
        const errorEl = zone.querySelector('.error')!;
        errorEl.textContent = '';

        if (file.size > 30 * 1024 * 1024) {
          errorEl.textContent = 'File too large (max 30 MB)';
          return;
        }

        uploadedFiles[stroke] = file;
        fileNameEl.textContent = `✓ ${file.name}`;
        zone.classList.add('selected');
      };
      input.click();
    });
  });

  document.getElementById('rateBtn')?.addEventListener('click', async () => {
    const result = document.getElementById('result')!;
    result.classList.add('show');
    document.getElementById('rScore')!.textContent = '…';
    document.getElementById('rNtrp')!.textContent = '…';
    document.getElementById('rCoach')!.textContent = '…';

    try {
      const res = await fetch('/api/evaluate', { method: 'POST' });
      const data = await res.json();
      document.getElementById('rScore')!.textContent = String(data.score);
      document.getElementById('rNtrp')!.textContent = String(data.ntrp);
      document.getElementById('rCoach')!.textContent = data.coachNote;

      const lang = localStorage.getItem('lang') || 'en';
      const localEvals = JSON.parse(localStorage.getItem('tennis_evaluations') || '[]');
      localEvals.push({
        score: data.score,
        ntrp: data.ntrp,
        date: new Date().toISOString().slice(0, 10),
        lang
      });
      localStorage.setItem('tennis_evaluations', JSON.stringify(localEvals));
    } catch {
      document.getElementById('rScore')!.textContent = '—';
      document.getElementById('rNtrp')!.textContent = '—';
      document.getElementById('rCoach')!.textContent = 'Error fetching result.';
    }

    result.scrollIntoView({ behavior: 'smooth' });
  });

  document.querySelector('.subscribe-btn')?.addEventListener('click', () => {
    alert('Stripe checkout placeholder — payment channel coming soon.');
  });
</script>
