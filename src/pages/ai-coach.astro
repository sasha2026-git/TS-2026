---
import Layout from '../layouts/Layout.astro';
import evaluations from '../data/evaluations.json';
---
<Layout title="AI Rating & Coach">
  <section class="hero" style="padding:4rem 5vw;">
    <h1 data-i18n="ai.title">AI Tennis Rating & Coach</h1>
    <p data-i18n="ai.sub">Upload 10 seconds of each stroke. Our AI rates your level (NTRP 1.0–7.0) and gives coach feedback.</p>
  </section>

  <section>
    <div class="upload-row">
      <div class="upload-zone" data-i18n="ai.upload">Upload Forehand Video</div>
      <div class="upload-zone" data-i18n="ai.upload2">Upload Backhand Video</div>
      <div class="upload-zone" data-i18n="ai.upload3">Upload Serve Video</div>
    </div>
    <p class="meta" style="margin:1rem 0 1.6rem;" data-i18n="ai.quota.free">Free member: 3 evaluations / month</p>
    <button class="btn btn-clay" id="rateBtn" data-i18n="ai.submit">Get My Rating</button>

    <div class="result-card" id="result" style="margin-top:2rem;">
      <h3 data-i18n="rating.result">Your result</h3>
      <p><span data-i18n="rating.score">Overall score</span>: <strong id="rScore" style="color:var(--clay);font-size:1.6rem;">—</strong> / 100</p>
      <p><span data-i18n="rating.level">Your level</span>: <strong id="rNtrp">—</strong> NTRP</p>
      <p><span data-i18n="rating.coach">Coach feedback</span>: <span id="rCoach">—</span></p>
      <p class="badge" style="margin-top:0.8rem;" data-i18n="rating.eligible">You are now eligible for level-matched events!</p>
    </div>
  </section>

  <section>
    <h2 data-i18n="ai.leaderboard">Community Leaderboard</h2>
    <table class="leaderboard">
      <thead>
        <tr>
          <th>#</th>
          <th data-i18n="ai.player">Player</th>
          <th data-i18n="ai.score">Score</th>
          <th data-i18n="ai.ntRP">NTRP</th>
        </tr>
      </thead>
      <tbody>
        {evaluations.evaluations
          .sort((a, b) => b.score - a.score)
          .map((e, i) => (
            <tr><td>{i + 1}</td><td>{e.player}</td><td>{e.score}</td><td>{e.ntrp}</td></tr>
          ))}
      </tbody>
    </table>
  </section>

  <section>
    <h2 data-i18n="pricing.title">Membership</h2>
    <div class="pricing">
      <div class="plan">
        <h3 data-i18n="pricing.free">Free</h3>
        <p class="price-tag">¥0</p>
        <ul><li data-i18n="pricing.free.f">3 AI evaluations / month</li></ul>
        <button class="btn btn-ghost" style="color:var(--green-dark);border-color:var(--green);" data-i18n="pricing.free2">Sign Up Free</button>
      </div>
      <div class="plan pro">
        <h3 data-i18n="pricing.pro">Pro</h3>
        <p class="price-tag" data-i18n="pricing.price.pro">$19 / month</p>
        <ul>
          <li data-i18n="pricing.pro.f">30 AI evaluations / month</li>
          <li data-i18n="pricing.pro.f2">Priority AI feedback</li>
        </ul>
        <button class="btn btn-clay subscribe-btn" data-i18n="pricing.pro.cta">Subscribe with Stripe</button>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('.upload-zone').forEach(z => {
    z.addEventListener('click', () => {
      const input = document.createElement('input');
      input.type = 'file';
      input.accept = 'video/*';
      input.onchange = () => {
        if (input.files?.[0]) z.style.borderColor = 'var(--green)';
        z.dataset.file = input.files?.[0]?.name || '';
      };
      input.click();
    });
  });
  document.getElementById('rateBtn')?.addEventListener('click', async () => {
    const r = document.getElementById('result');
    r.classList.add('show');
    document.getElementById('rScore').textContent = '…';
    try {
      const res = await fetch('/api/evaluate', { method: 'POST' });
      const data = await res.json();
      document.getElementById('rScore').textContent = data.score;
      document.getElementById('rNtrp').textContent = data.ntrp;
      document.getElementById('rCoach').textContent = data.coachNote;
    } catch {
      document.getElementById('rScore').textContent = '—';
    }
  });
  document.querySelector('.subscribe-btn')?.addEventListener('click', () => {
    console.log('TODO Stripe subscription checkout');
    alert('Stripe checkout placeholder — wire STRIPE_SECRET_KEY on backend.');
  });
</script>
